{
  "name": "gestor-de-oficinas",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @gestor/database db:generate",
    "db:migrate": "pnpm --filter @gestor/database db:migrate",
    "db:deploy": "pnpm --filter @gestor/database db:deploy",
    "db:seed": "pnpm --filter @gestor/database db:seed && pnpm --filter @gestor/web seed:owner",
    "db:seed:owner": "pnpm --filter @gestor/web seed:owner",
    "db:seed:mock": "pnpm --filter @gestor/database db:seed:mock",
    "db:rls": "pnpm --filter @gestor/database db:rls",
    "db:test:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-test.ps1 start",
    "db:test:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-test.ps1 stop",
    "db:test:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-test.ps1 status",
    "db:test:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-test.ps1 reset",
    "db:studio": "pnpm --filter @gestor/database studio",
    "clean": "pnpm --filter @gestor/web clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}

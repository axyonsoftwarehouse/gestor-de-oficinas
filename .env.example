# === Banco de dados ===
# Owner/superusuário: usado por migrations e seeds.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor?schema=public"
# Papel de aplicação (não-superusuário), sujeito ao RLS. Opcional em dev.
APP_DATABASE_URL="postgresql://app_gestor:app_gestor@localhost:5432/gestor?schema=public"

# === Neon (alvo da migração) ===
# Pooler em transaction mode (porta 6543) + pgbouncer para o runtime serverless.
# DATABASE_URL="postgresql://<user>:<senha>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432) usada por migrations.
# DIRECT_URL="postgresql://<user>:<senha>@<host>.<region>.aws.neon.tech/neondb?sslmode=require"

# === Auth (Better Auth) ===
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# === API ===
API_PORT=3333
API_GLOBAL_PREFIX=api
WEB_URL="http://localhost:3000"
# Opcional: origens extras permitidas no CORS (produção). Em dev reflete a origem.
# CORS_ORIGINS="https://app.suaoficina.com,https://admin.suaoficina.com"

# === Web (Next.js) ===
# Mesma origem: as rotas ficam em /api (deixe vazio ou "/api").
NEXT_PUBLIC_API_URL="/api"

# === Auth (JWT) ===
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="15m"
REFRESH_SECRET="troque-este-segredo-de-refresh"
REFRESH_EXPIRES_IN="30d"

# === Storage (S3-compatível) ===
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="gestor-oficinas"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# === Seed ===
SEED_DEMO_TENANT="true"
SEED_OWNER_EMAIL="owner@oficina.local"
SEED_OWNER_PASSWORD="password"

# === Testes (banco dedicado: Neon branch ou Postgres local) ===
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""
TEST_APP_DATABASE_URL=""

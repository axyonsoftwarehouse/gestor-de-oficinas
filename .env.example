# === Banco de dados (PostgreSQL) ===
# Produção: Neon. Dev/teste: um Postgres local (ajuste as URLs).
# Runtime: pooler em transaction mode (porta 6543) + pgbouncer.
DATABASE_URL="postgresql://<user>:<senha>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Papel de aplicação (NOBYPASSRLS): obrigatório para a RLS valer de fato.
APP_DATABASE_URL="postgresql://app_gestor:<senha>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432), usada por migrations.
DIRECT_URL="postgresql://<user>:<senha>@<host>.<region>.aws.neon.tech/neondb?sslmode=require"

# === Auth (Better Auth) ===
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# === Web (Next.js) ===
# Mesma origem: as rotas ficam em /api.
NEXT_PUBLIC_API_URL="/api"

# === Storage (backlog) ===
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="gestor-oficinas"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# === Seed ===
SEED_DEMO_TENANT="true"
SEED_OWNER_EMAIL="owner@oficina.local"
SEED_OWNER_PASSWORD="password"

# === Testes (banco dedicado: Neon branch ou Postgres local) ===
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""
TEST_APP_DATABASE_URL=""

# === Backup offsite (scripts/backup-db.mjs; ver docs/backups-e-rotacao.md) ===
# Não são lidas pelo runtime web. BACKUP_DATABASE_URL tem prioridade sobre DIRECT_URL.
BACKUP_DATABASE_URL=""
BACKUP_ENCRYPTION_KEY="gere-com-openssl-rand-base64-48"
BACKUP_DIR=".backups"
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_PREFIX="gestor-oficinas"
# Credenciais de upload (variáveis padrão da AWS CLI):
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BACKUP_RETENTION_DAYS="30"
BACKUP_MONTHLY_RETENTION_DAYS="365"

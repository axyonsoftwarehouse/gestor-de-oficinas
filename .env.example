# === Banco de dados ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor?schema=public"

# === API ===
API_PORT=3333
API_GLOBAL_PREFIX=api
WEB_URL="http://localhost:3000"

# === Auth (JWT) ===
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="15m"
REFRESH_SECRET="troque-este-segredo-de-refresh"
REFRESH_EXPIRES_IN="30d"

# === Storage (S3-compatível) ===
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="gestor-oficinas"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# === Seed ===
SEED_DEMO_TENANT="true"
SEED_OWNER_EMAIL="owner@oficina.local"
SEED_OWNER_PASSWORD="password"

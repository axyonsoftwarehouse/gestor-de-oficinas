{
  "name": "@gestor/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "next build",
    "start": "dotenv -e ../../.env -- next start -p 3000",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "seed:owner": "dotenv -e ../../.env -- tsx scripts/seed-owner.ts"
  },
  "dependencies": {
    "@gestor/database": "workspace:*",
    "@gestor/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.0",
    "better-auth": "^1.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "lucide-react": "^1.48.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^7.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
